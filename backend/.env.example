# FastAPI Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=info

# Database Connection
# Replace with your actual Supabase / PostgreSQL credentials
# Format: postgresql+asyncpg://user:password@host:port/dbname (for async)
# Format: postgresql://user:password@host:port/dbname (for sync/migration tools)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leads_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leads_db

# Groq LLM API Configuration
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# API Authentication Security (Optional)
# If provided, requests will need header "X-API-KEY: your-api-key"
API_KEY=secret-api-key-token-here
